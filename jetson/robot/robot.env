# 実機の実行系（elevator-task）の設定の雛形.
# 使うのは /etc/elevator-task/robot.env（robot_up.sh を初めて実行したときに、これをコピーして作る）.
# 書き換えたら: bash jetson/robot/robot_up.sh（実行系を起動し直す）

# ROS 2 のドメイン. 安全ゲート（/etc/safety-gate/config.yaml の ros_domain_id）、
# カメラ（/etc/usb-camera/camera.env の ROS_DOMAIN_ID）、ロボットの PC の橋渡しと同じ番号にする.
# 変えるときは、3 か所をまとめて変える: bash jetson/robot/set_domain.sh <番号>
ROS_DOMAIN_ID=42

# オドメトリ（nav_msgs/Odometry）のトピック. 橋渡しはトピックの名前を変えられないので、
# ロボット（ROS 1）が出している名前と同じにする（ロボットの PC で rostopic list）
ODOM_TOPIC=/odom
