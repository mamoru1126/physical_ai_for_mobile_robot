# USB カメラのサービスの設定. jetson/camera/install.sh が /etc/usb-camera/camera.env にコピーする.
# 入れたあとに変えるときは /etc/usb-camera/camera.env を書き換えて、sudo systemctl restart usb-camera

# カメラのデバイス. auto なら、USB のカメラを探す（例: /dev/video0、/dev/v4l/by-id/... も指定できる）
CAMERA_DEVICE=auto
# 画像の大きさと 1 秒あたりの枚数（カメラが対応している組み合わせにする. ログに一覧が出る）
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30.0
# カメラから受け取る形式. 多くの USB カメラは mjpeg2rgb. うまくいかなければ yuyv2rgb
CAMERA_PIXEL_FORMAT=mjpeg2rgb
# ロボットのカメラとして使う. トピックは /camera/image_raw と /camera/camera_info.
# 圧縮した画像は omnivla_real（configs/robot.yaml）と同じ /camera/compressed に出す
CAMERA_NAMESPACE=camera
CAMERA_COMPRESSED_TOPIC=/camera/compressed
CAMERA_FRAME_ID=camera
# カメラの校正ファイル（例: file:///etc/usb-camera/camera_info.yaml）. 空なら無し
CAMERA_INFO_URL=
# ブラウザで見るためのポート
CAMERA_WEB_PORT=9000

# ROS 2 の設定. ロボット（omnivla_real）と同じドメイン 42. ほかの PC とやりとりするなら、相手とそろえる
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
