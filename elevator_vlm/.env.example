# cp .env.example .env して編集する（docker compose が自動で読む）

# ---- VLM サーバ（vLLM）--------------------------------------------------------
# 既定は Qwen3.5-9B の 4bit 量子化版（約 11 GB）. RTX 3090（24 GB）で Gazebo と同居できる.
VLM_HF_MODEL=RedHatAI/Qwen3.5-9B-quantized.w4a16
# vLLM が確保する GPU メモリの割合. 残りを Gazebo と画面の描画に使う
VLM_GPU_MEMORY_UTILIZATION=0.65
VLM_MAX_MODEL_LEN=8192
VLLM_IMAGE=vllm/vllm-openai:latest
# 公開モデルなら空でよい
HF_TOKEN=

# ---- 実行系から見た VLM サーバの場所 -----------------------------------------------
# 別の PC の VLM サーバを使うときは、その PC の IP アドレスにする
VLM_BASE_URL=http://127.0.0.1:8000/v1
VLM_MODEL=vlm

# ---- シミュレーション -----------------------------------------------------------
# false にすると Gazebo の画面を出さない（様子は Web UI の「外からの映像」で見られる）
GUI=true
# 扉を全開で保持する秒数
DOOR_HOLD_S=6.0
# 出入口に物があれば閉めない・開き直す（多光軸センサに当たる）
DOOR_SENSOR=true
BOARD_FLOOR=1
DEST_FLOOR=3
WEB_PORT=8080

ROS_DOMAIN_ID=42
GZ_PARTITION=elevator
