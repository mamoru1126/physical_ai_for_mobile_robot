# ROS 1 と ROS 2 の橋渡しの設定. 書き換えたら: sudo systemctl restart ros1-bridge
# （入れたあとは /etc/ros1-bridge/bridge.env を書き換える）. ふつうは書き換えなくてよい

# ROS 1 の roscore. auto なら、同じネットワークからポート 11311 の roscore を探す.
# roscore が複数あるネットワークでは、http://192.168.0.10:11311 のように書く
ROS_MASTER_URI=auto
# この Orin の IP. auto なら、roscore の PC へ届く IP を自動で選ぶ
ROS1_IP=auto
# 向こうのノードが名前（ホスト名）で名乗っていて、名前が引けないときの扱い.
# auto なら、roscore と同じ PC とみなす. 別の PC のノードがあるときは、名前と IP を足す
# 例: ROS1_HOSTS=auto lidar-pc:192.168.0.101（" で囲まない）
ROS1_HOSTS=auto

# ROS 1 から ROS 2 へ（向こうのトピックを受ける）
ODOM_TOPIC=/odom
CLOUD_TOPIC=/cloud
# ROS 2 から ROS 1 へ（こちらの速度の指令を流す）
CMD_VEL_TOPIC=/cmd_vel

# ROS 2 の設定. ロボット（omnivla_real）と同じドメイン 42
ROS_DOMAIN_ID=42
