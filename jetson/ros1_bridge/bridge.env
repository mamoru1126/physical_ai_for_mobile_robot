# ROS 1 と ROS 2 の橋渡しの設定. 書き換えたら: sudo systemctl restart ros1-bridge
# （入れたあとは /etc/ros1-bridge/bridge.env を書き換える）

# ROS 1 の roscore が動いている PC. 必ず書き換える
ROS_MASTER_URI=http://192.168.0.100:11311
# この Orin の IP. auto なら、ROS_MASTER_URI の PC へ届く IP を自動で選ぶ
ROS1_IP=auto
# ROS 1 の PC が自分の名前（ホスト名）で名乗る場合に、名前と IP を書く（空白区切り）.
# 例: ROS1_HOSTS=atmobi-pc:192.168.0.100 other-pc:192.168.0.101（" で囲まない）
ROS1_HOSTS=

# ROS 1 から ROS 2 へ（向こうのトピックを受ける）
ODOM_TOPIC=/odom
CLOUD_TOPIC=/cloud
# ROS 2 から ROS 1 へ（こちらの速度の指令を流す）
CMD_VEL_TOPIC=/cmd_vel

# ROS 2 の設定. ロボット（omnivla_real）と同じドメイン 42
ROS_DOMAIN_ID=42
