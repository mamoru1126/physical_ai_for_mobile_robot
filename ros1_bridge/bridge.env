# ROS 1 と ROS 2 の橋渡しの設定. ロボットの PC（ROS 1 が動いている PC）で使う.
# 書き換えたら: sudo systemctl restart ros1-bridge
# （入れたあとは /etc/ros1-bridge/bridge.env を書き換える）. ふつうは書き換えなくてよい

# ROS 1 の roscore. 同じ PC の roscore（ROS 1 の既定と同じ）.
# auto にすると、同じネットワークからポート 11311 の roscore を探す
ROS_MASTER_URI=http://localhost:11311
# この PC の IP（ROS 1 のノードどうしがつなぐときに使う）. auto なら、roscore へ届く IP を選ぶ.
# roscore が localhost なら 127.0.0.1 になる
ROS1_IP=auto
# 向こうのノードが名前（ホスト名）で名乗っていて、名前が引けないときの扱い.
# auto なら、roscore と同じ PC とみなす. 別の PC のノードがあるときは、名前と IP を足す
# 例: ROS1_HOSTS=auto lidar-pc:192.168.0.101（" で囲まない）
ROS1_HOSTS=auto

# ROS 1 から ROS 2 へ（向こうのトピックを受ける）
ODOM_TOPIC=/odom
CLOUD_TOPIC=/cloud
# ROS 2 から ROS 1 へ（こちらの速度の指令を流す）
CMD_VEL_TOPIC=/cmd_vel
# TF（/tf と /tf_static）も橋渡しするか. 安全ゲートが点群を base_link に直すのに使う
BRIDGE_TF=true

# ROS 2 の設定. Orin（omnivla_real）と同じドメイン 42. ROS 2 は相手を自動で見つける
ROS_DOMAIN_ID=42
# ROS 2 の相手が自動で見つからないとき（無線などでマルチキャストが通らないとき）だけ、
# 相手の IP を空白区切りで書く. 例: ROS2_PEERS=192.168.0.200
ROS2_PEERS=
