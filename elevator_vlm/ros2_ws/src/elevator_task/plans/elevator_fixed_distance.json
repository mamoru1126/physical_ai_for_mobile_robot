{
  "steps": [
    {
      "instruction": "扉が開いたら 1.75 m 前進して",
      "when": { "type": "when_true", "condition": "Elevator door is fully open." },
      "do": { "skill": "move_straight", "distance_m": 1.75 },
      "timeout_s": 120
    },
    {
      "instruction": "中に入ったら180度旋回して",
      "when": { "type": "now" },
      "do": { "skill": "rotate", "angle_deg": 180 },
      "timeout_s": 30
    },
    {
      "instruction": "再び扉が開いたら 1.75 m 前進して",
      "when": { "type": "after_false_then_true", "condition": "Elevator door is fully open." },
      "do": { "skill": "move_straight", "distance_m": 1.75 },
      "timeout_s": 300
    }
  ]
}
