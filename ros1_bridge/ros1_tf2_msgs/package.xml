<?xml version="1.0"?>
<!-- ROS 1 の tf2_msgs（メッセージだけ）. ros1_bridge が ROS 1 の tf2_msgs を見つけるために置く.
     C++ のヘッダは Ubuntu の libtf2-msgs-dev のものを使う -->
<package format="2">
  <name>tf2_msgs</name>
  <version>0.7.5</version>
  <description>tf2_msgs (ROS 1) message definitions for ros1_bridge</description>
  <maintainer email="maintainer@example.com">maintainer</maintainer>
  <license>BSD</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>geometry_msgs</depend>
  <exec_depend>message_runtime</exec_depend>
</package>
